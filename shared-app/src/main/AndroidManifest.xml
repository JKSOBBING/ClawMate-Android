<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name=".SharedApplication" android:allowBackup="false"
        android:label="ClawMate 共享前端" android:supportsRtl="true"
        android:extractNativeLibs="true" android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Light.NoTitleBar">
        <activity android:name=".SharedActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|keyboard|layoutDirection|screenSize|screenLayout|uiMode|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
