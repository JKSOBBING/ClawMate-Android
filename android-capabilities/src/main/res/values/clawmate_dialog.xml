<resources>
    <color name="clawmate_dialog_surface">#FFFFFF</color>
    <color name="clawmate_dialog_text">#172033</color>
    <color name="clawmate_dialog_secondary">#536078</color>
    <color name="clawmate_dialog_accent">#4258CE</color>
    <color name="clawmate_dialog_outline">#DCE3EF</color>
    <style name="ClawMateSetup" parent="@android:style/Theme.Material.Light">
        <item name="android:windowBackground">#F6F8FC</item>
        <item name="android:colorAccent">@color/clawmate_dialog_accent</item>
        <item name="android:colorPrimary">@color/clawmate_dialog_surface</item>
        <item name="android:textColorPrimary">@color/clawmate_dialog_text</item>
        <item name="android:textColorSecondary">@color/clawmate_dialog_secondary</item>
        <item name="android:alertDialogTheme">@style/ClawMateDialog</item>
    </style>
    <style name="ClawMateDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/clawmate_dialog_surface</item>
        <item name="android:colorAccent">@color/clawmate_dialog_accent</item>
        <item name="android:textColorPrimary">@color/clawmate_dialog_text</item>
        <item name="android:textColorSecondary">@color/clawmate_dialog_secondary</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:windowElevation">10dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
