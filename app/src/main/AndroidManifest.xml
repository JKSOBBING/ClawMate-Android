<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Voice input (on-device ASR). TTS needs no permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service for long-running agent workflows / background data transfer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Phase 20 (row C1) — float/edge overlay boundary.
        Declaring SYSTEM_ALERT_WINDOW is the manifest prerequisite for the
        truthful overlay gate: Settings.canDrawOverlays() can only ever report
        true when this permission is declared, and the grant itself is made by
        the user in the SYSTEM-Managed overlay settings screen
        (ACTION_MANAGE_OVERLAY_PERMISSION) — never by a runtime prompt and never
        silently. Declaring it does NOT auto-enable any overlay: nothing in this
        build starts OverlayFloatService, which in turn is lifecycle-safe (it
        refuses to start unless the OverlayGate is READY, and renders only a
        neutral status surface).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ClawMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClawMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ClawMate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Profile sharing / import: opening .mobi-profile JSON summary files. -->
        <activity
            android:name=".profile.ProfileShareActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/vnd.mobiinfra.profile+json" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*"
                    android:pathPattern=".*\\.mobi\\-profile(\\.json)?$" />
            </intent-filter>
        </activity>

        <!-- content:// provider for sharing/importing .mobi-profile summary files.
             Modern Android forbids sharing via file:// URIs; FileProvider is the
             required adapter (HarmonyOS source: ShareKit + file-open Want). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Phase 19 + Phase 22 — AutoAgent controlled-accessibility boundary (row B1).
            A lifecycle-safe service that (a) records availability into
            AccessibilityStateRegistry (Phase 19) and (b) performs ONLY the safe
            *semantic* actions of the Phase 22 typed allowlist
            (CLICK_TEXT / CLICK_CONTENT_DESCRIPTION / BACK / SCROLL_FORWARD /
            SCROLL_BACKWARD / GLOBAL_BACK / GLOBAL_HOME) — and only when invoked
            through AccessibilityAutoAgentService.executeSafeAction, with the live
            foreground package validated against the allowlist before every action.
            It never performs gestures/hidden input (canPerformGestures=false), never
            captures/exfiltrates screenshots, never starts silently, and the Phase 19
            coordinate boundary stays BLOCKED/NOT_CONFIGURED. Availability is surfaced
            through AccessibilityGate (Phase 19) and the new safe executor gate.
        -->
        <service
            android:name=".accessibility.AccessibilityAutoAgentService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_autoagent_config" />
        </service>

        <!--
            Phase 20 (row C1) — float/edge overlay boundary.
            A lifecycle-safe scaffold. It is neither auto-started anywhere nor
            exported to other apps (it has no intent-filter and does not bind).
            On the only paths that could run it, it derives the OverlayGate from
            observed opt-in + observed system overlay grant and refuses to stay
            alive unless the gate is READY; in this build the renderer is absent
            so it always self-terminates. It can only ever render the honest
            neutral status surface (no agent content, no captured screens, no
            GUI actions). Availability is surfaced through OverlayGate /
            OverlayServicePolicy.
        -->
        <service
            android:name=".overlay.OverlayFloatService"
            android:exported="false"
            android:label="@string/app_name" />
    </application>
</manifest>
